#!/usr/bin/env bash
set -euo pipefail

docker_cli=""
for candidate in /usr/bin/docker /bin/docker /usr/local/bin/docker; do
  if [[ -x "${candidate}" && ! "${candidate}" -ef "$0" ]]; then
    docker_cli="${candidate}"
    break
  fi
done

if [[ -z "${docker_cli}" ]]; then
  echo "Docker CLI is not installed" >&2
  exit 127
fi

if [[ "${1:-}" == "build" ]]; then
  shift
  exec "${docker_cli}" buildx build \
    --builder agent-builder \
    --network host \
    --allow network.host \
    "$@"
fi

exec "${docker_cli}" "$@"
