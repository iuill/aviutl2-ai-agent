#!/usr/bin/env bash

set -euo pipefail

codex_cli=""
for candidate in /usr/local/bin/codex /usr/bin/codex /bin/codex; do
  if [[ -x "${candidate}" && ! "${candidate}" -ef "$0" ]]; then
    codex_cli="${candidate}"
    break
  fi
done

if [[ -z "${codex_cli}" ]]; then
  echo "Codex CLI is not installed" >&2
  exit 127
fi

exec "${codex_cli}" \
  --dangerously-bypass-approvals-and-sandbox \
  "$@"
